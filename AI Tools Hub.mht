@charset "utf-8";

* { box-sizing: border-box; }

body { margin: 0px; font-family: Arial, sans-serif; background: rgb(245, 247, 251); color: rgb(34, 34, 34); }

header { background: rgb(17, 24, 39); color: white; }

.navbar { max-width: 1100px; margin: auto; padding: 20px; display: flex; justify-content: space-between; align-items: center; }

.logo { font-size: 22px; font-weight: bold; }

.nav-links { display: flex; gap: 20px; }

.nav-links a { color: white; text-decoration: none; }

.hero { text-align: center; padding: 50px 20px 70px; }

.hero h1 { font-size: 42px; margin-bottom: 15px; }

.hero p { color: rgb(209, 213, 219); font-size: 18px; }

.search { width: 90%; max-width: 600px; padding: 15px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 10px; font-size: 16px; margin-top: 20px; outline: none; }

.container { max-width: 1100px; margin: 40px auto; padding: 0px 20px; }

.categories { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 40px; }

.category { padding: 11px 18px; border: 1px solid rgb(221, 221, 221); background: white; border-radius: 8px; cursor: pointer; font-size: 15px; }

.category:hover { background: rgb(79, 70, 229); color: white; }

.tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }

.tool { background: white; padding: 22px; border-radius: 14px; box-shadow: rgba(0, 0, 0, 0.08) 0px 4px 15px; }

.tool h3 { margin-top: 0px; font-size: 21px; }

#about { scroll-margin-top: 20px; }

.badge { display: inline-block; background: rgb(232, 245, 233); color: rgb(46, 125, 50); padding: 5px 10px; border-radius: 20px; font-size: 12px; margin-bottom: 10px; }

.tool p { color: rgb(85, 85, 85); line-height: 1.5; }

.button { display: inline-block; margin-top: 10px; padding: 10px 16px; background: rgb(79, 70, 229); color: white; text-decoration: none; border-radius: 7px; }

.button:hover { background: rgb(55, 48, 163); }

footer { margin-top: 60px; padding: 30px; text-align: center; background: rgb(17, 24, 39); color: white; }

@media (max-width: 600px) {
  .navbar { flex-direction: column; gap: 15px; }
  .nav-links { flex-wrap: wrap; justify-content: center; }
  .hero h1 { font-size: 32px; }
}
